<?xml version="1.0" encoding="utf-8"?>
<!-- The app opens on its own ink black with the seal resting in the middle,
     so the first frame the engine draws does not flash white. Matches
     Splash.tsx on the desktop build. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
