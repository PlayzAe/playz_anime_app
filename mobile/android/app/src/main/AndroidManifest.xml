<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reading a catalogue, resolving streams and downloading episodes. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Storage and media permissions for saving downloaded anime videos and manga chapters
         to user-accessible media folders (Movies / Downloads). -->
    <!-- Android 11+: "All files access", asked for on first launch, so downloads can go
         to any folder the user picks (sideloaded build, not on Play). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Downloads keep going while the screen is off, and the player must not let
         the display sleep mid-episode. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 13+ asks before an app may post anything. Downloads report progress. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Playback in the background, and the lock-screen controls. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Deliberately NOT requested: no location, no contacts, no camera. -->

    <!-- Some of the chapter sources and image CDNs are reachable over plain HTTP
         only. Without this the reader shows broken pages on those sites. -->
    <application
        android:label="PlayzAnime"
        android:requestLegacyExternalStorage="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:hasFragileUserData="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- A .playzanime profile shared from another phone opens straight into
                 the import flow, the same way the desktop app registered the file
                 association. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/octet-stream" android:pathPattern=".*\\.playzanime" />
                <data android:scheme="file" android:pathPattern=".*\\.playzanime" />
            </intent-filter>
        </activity>

        <!-- The launcher icon follows the accent (like Discord's Nitro icons): one alias
             per accent, exactly one enabled. MainActivity.applyIcon swaps them. -->
        <activity-alias
            android:name=".Icon_shu"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_shu"
            android:roundIcon="@mipmap/ic_launcher_shu"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_matcha"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_matcha"
            android:roundIcon="@mipmap/ic_launcher_matcha"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_ai"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ai"
            android:roundIcon="@mipmap/ic_launcher_ai"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_yamabuki"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_yamabuki"
            android:roundIcon="@mipmap/ic_launcher_yamabuki"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Icon_sakura"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sakura"
            android:roundIcon="@mipmap/ic_launcher_sakura"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".MediaReceiver"
            android:exported="false" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <!-- url_launcher: opening a source page or a profile link. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
