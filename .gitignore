# Dependencies
node_modules/
__pycache__/
*.pyc

# Build output. api/_lib/ and api/blocklist.json stay committed: Vercel looks for its
# functions before building, and the build regenerates them anyway.
dist/
server/dist/
.vercel/

# Server runtime data (feed cache, logs)
server/data/

# Logs & temporary video
*.log
*.mp4

# Environment & IDE
.env
.env.*
!.env.example
.vscode/
.idea/
.vs/

# Scratch, temporary files & test outputs
*.py
*.ps1
*.tmp
*.temp
scripts/temp*
scripts/fix*
scripts/update*
scripts/*.html
test-results/
coverage/

# OS metadata
Thumbs.db
Desktop.ini
.DS_Store

out/
release/
reference/

# Mobile app: keep its icon script, never commit signing keys or APKs.
!mobile/tools/*.ps1
*.jks
*.keystore
key.properties
*.apk
*.aab
